# Copy to .env (npm run db:setup creates one automatically for local development).
DATABASE_URL="postgresql://zenorra:zenorra-local-dev@127.0.0.1:54329/zenorra?schema=public"
SESSION_SECRET="replace-with-32+-random-characters"
APP_URL="http://localhost:3000"
MEDIA_DIR="uploads"

# Optional integrations — leave empty to record messages in Admin → Notifications only.
RESEND_API_KEY=""
MAIL_FROM="Zenorra <no-reply@yourdomain>"
TERMII_API_KEY=""
TERMII_SENDER_ID="Zenorra"
CRON_SECRET=""

# Phase 3 — Paystack. Without a key, "Pay now" opens a local simulator (/account/pay/simulate, dev only).
# Webhook URL to register in the Paystack dashboard: {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""

# Phase 2 — WhatsApp Cloud API (Meta). Webhook URL: {APP_URL}/api/webhooks/whatsapp
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# Phase 3 — Flutterwave (alternative to Paystack; choose the provider in Admin → Settings → Online payments).
# FLW_SECRET_HASH is the "secret hash" you set in the Flutterwave dashboard; webhook URL: {APP_URL}/api/webhooks/flutterwave
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""

# Video conversion uses the ffmpeg binary bundled by @ffmpeg-installer. Set this to use a system ffmpeg instead.
FFMPEG_PATH=""
