{
  "name": "zenorra-website",
  "version": "0.1.0",
  "private": true,
  "description": "Zenorra digital platform — public marketing site and admin portal (SRS Phase 1)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:start": "node scripts/db.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --selectProjects unit components",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit --testTimeout=30000",
    "test:coverage": "jest --selectProjects unit components --coverage",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.0",
    "@tiptap/extension-image": "3.22.5",
    "@tiptap/extension-link": "3.22.5",
    "@tiptap/pm": "3.22.5",
    "@tiptap/react": "3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "next": "^16.3.8",
    "otplib": "^12.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "embedded-postgres": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
