// Zenorra platform — SRS v1.0 §7.7 data model (Phase 1 entities).
// Phase 3 entities (Buyer, Purchase, Instalment, Payment, Document, Referral)
// are intentionally not created yet; nothing here needs rework to add them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMINISTRATOR
  EDITOR
  ADVISOR
  VIEWER
  PARTNER // partner developer — read-only view of their own estates (Phase 3)
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  passwordHash      String?
  role              Role       @default(VIEWER)
  status            UserStatus @default(INVITED)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean    @default(false)
  failedLogins      Int        @default(0)
  failedWindowStart DateTime?
  lockedUntil       DateTime?
  inviteToken       String?    @unique
  inviteExpires     DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions     Session[]
  chatMessages ChatMessage[]
  posts        Post[]
  auditLogs    AuditLog[]
  activities   LeadActivity[]
  leads        Lead[]         @relation("assignedLeads")
  partnerId    String?
  partner      Partner?       @relation(fields: [partnerId], references: [id])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  ARCHIVED
}

enum Availability {
  AVAILABLE
  SELLING_FAST
  SOLD_OUT
}

enum TitleType {
  C_OF_O
  GOVERNORS_CONSENT
  EXCISION
  GAZETTE
  REGISTERED_SURVEY
  EXCISION_IN_PROGRESS
  OTHER
}

model Property {
  id               String         @id @default(cuid())
  reference        String         @unique
  slug             String         @unique
  name             String
  corridor         String
  locationText     String
  lat              Float?
  lng              Float?
  titleType        TitleType
  titleLabel       String?
  titleDocRef      String?
  sizeText         String?
  sizeSqm          Int?
  priceNaira       BigInt
  priceUnit        String?
  depositPercent   Int            @default(30)
  planMonths       Int            @default(12)
  allocationText   String?
  currencies       String[]       @default(["NGN"])
  appreciationNote String?
  blurb            String?
  description      String?
  features         String[]       @default([])
  badges           String[]       @default([])
  availability     Availability   @default(AVAILABLE)
  status           PropertyStatus @default(DRAFT)
  featured         Boolean        @default(false)
  featuredOrder    Int?
  curatedOrder     Int            @default(0)
  heroBrief        String?
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  phases    PropertyPhase[]
  media     PropertyMedia[]
  documents PropertyDocument[]
  leads     Lead[]
  bookings  Booking[]
  purchases Purchase[]
  partnerId String?
  partner   Partner?           @relation(fields: [partnerId], references: [id])

  @@index([status, corridor, priceNaira])
}

model PropertyPhase {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  priceNaira     BigInt
  plotsTotal     Int       @default(0)
  plotsAvailable Int       @default(0)
  status         String    @default("SELLING")
  opensAt        DateTime?
  order          Int       @default(0)
}

model PropertyMedia {
  id           String     @id @default(cuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  order        Int        @default(0)
  role         String     @default("gallery")

  @@unique([propertyId, mediaAssetId])
}

model PropertyDocument {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  kind         String
  label        String
  isPublic     Boolean    @default(false)
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  posts       Post[]
}

model Post {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  excerpt         String?
  body            Json?
  bodyHtml        String?
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  authorId        String?
  author          User?       @relation(fields: [authorId], references: [id])
  authorName      String?
  coverMediaId    String?
  coverMedia      MediaAsset? @relation(fields: [coverMediaId], references: [id])
  status          PostStatus  @default(DRAFT)
  publishedAt     DateTime?
  readingMinutes  Int?
  readingOverride Boolean     @default(false)
  seoTitle        String?
  seoDescription  String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  revisions PostRevision[]

  @@index([status, publishedAt])
}

model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  body      Json?
  createdBy String?
  createdAt DateTime @default(now())
}

model MediaAsset {
  id          String    @id @default(cuid())
  key         String    @unique
  filename    String
  mimeType    String
  bytes       Int
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  focalX      Float?
  focalY      Float?
  derivatives Json?
  // Video (FR-ADM-028): QUEUED | PROCESSING | READY | FAILED; null for images and documents
  videoStatus String?
  videoError  String?
  durationSec Float?
  posterKey   String?
  sourceKey   String?
  uploadedBy  String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  propertyMedia  PropertyMedia[]
  documents      PropertyDocument[]
  posts          Post[]
  testimonials   Testimonial[]
  teamMembers    TeamMember[]
  partners       Partner[]
  buyerDocuments BuyerDocument[]
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED_INSPECTION
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id                 String     @id @default(cuid())
  reference          String     @unique
  name               String
  phoneE164          String?
  email              String?
  objective          String?
  corridors          String[]   @default([])
  budgetBand         String?
  timeline           String?
  residency          String?
  note               String?
  enquiryType        String?
  propertyId         String?
  property           Property?  @relation(fields: [propertyId], references: [id])
  source             String
  status             LeadStatus @default(NEW)
  score              Int?
  assignedToId       String?
  assignedTo         User?      @relation("assignedLeads", fields: [assignedToId], references: [id])
  utm                Json?
  landingPath        String?
  pagePath           String?
  referrer           String?
  deviceClass        String?
  marketingConsent   Boolean    @default(false)
  disposableEmail    Boolean    @default(false)
  readAt             DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastContactedAt    DateTime?
  // Phase 2
  isPartial          Boolean    @default(false)
  callbackWindow     String?
  whatsappOptIn      Boolean    @default(false)
  firstResponseDueAt DateTime?
  escalatedAt        DateTime?
  channelInvalid     String[]   @default([])
  // Phase 3
  referralCode       String?

  activities LeadActivity[]
  consents   Consent[]
  bookings   Booking[]
  chats      ChatThread[]
  buyer      Buyer?
  referral   Referral?

  @@index([phoneE164])
  @@index([email])
  @@index([status, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  payload   Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Consent {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  purpose      String
  granted      Boolean
  textVersion  String
  textSnapshot String
  ip           String?
  userAgent    String?
  grantedAt    DateTime  @default(now())
  withdrawnAt  DateTime?
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id])
  date           DateTime      @db.Date
  departurePoint String
  seats          Int
  status         BookingStatus @default(PENDING)
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([date])
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model Subscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         SubscriberStatus @default(PENDING)
  confirmToken   String?          @unique
  tokenExpires   DateTime?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
}

model Testimonial {
  id           String      @id @default(cuid())
  name         String
  roleText     String
  quote        String
  initials     String?
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  videoUrl     String?
  order        Int         @default(0)
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Site-wide settings: contact details, hours, social links, WhatsApp, departure points.
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Editable copy for every section of every public page (headlines, paragraphs,
// lists, CTAs). The field schema for each key lives in lib/content/registry.ts.
model ContentBlock {
  key       String   @id
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

// Append-only. See prisma/sql/audit-immutable.sql for the trigger that blocks UPDATE/DELETE.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// Outbox for email/SMS/WhatsApp. A lead is always persisted before a row lands here.
model Notification {
  id            String             @id @default(cuid())
  channel       String
  to            String
  template      String
  payload       Json
  status        NotificationStatus @default(QUEUED)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  leadId        String?
  createdAt     DateTime           @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// Fixed-window rate limit counters (Redis stand-in for local/self-hosted runs).
model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime
}

// ======================================================================
// Phase 2 — live chat, team, partners
// ======================================================================

enum ChatStatus {
  OPEN
  CLOSED
}

model ChatThread {
  id            String        @id @default(cuid())
  visitorToken  String        @unique
  name          String?
  contact       String?
  pagePath      String?
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status        ChatStatus    @default(OPEN)
  unreadByStaff Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]

  @@index([status, lastMessageAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String // VISITOR | STAFF | SYSTEM
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

model TeamMember {
  id           String      @id @default(cuid())
  name         String
  roleText     String
  bio          String?
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  order        Int         @default(0)
  published    Boolean     @default(true)
}

model Partner {
  id           String      @id @default(cuid())
  name         String
  kind         String // DEVELOPER | SOLAR | OTHER
  url          String?
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  order        Int         @default(0)
  published    Boolean     @default(true)

  properties Property[]
  users      User[]
}

// ======================================================================
// Phase 3 — buyer portal, payments, referrals (all money in kobo)
// ======================================================================

enum BuyerStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Buyer {
  id            String      @id @default(cuid())
  leadId        String?     @unique
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name          String
  phoneE164     String?     @unique
  email         String?     @unique
  passwordHash  String?
  referralCode  String      @unique
  status        BuyerStatus @default(INVITED)
  inviteToken   String?     @unique
  inviteExpires DateTime?
  createdAt     DateTime    @default(now())
  lastLoginAt   DateTime?

  sessions  BuyerSession[]
  otps      BuyerOtp[]
  purchases Purchase[]
  documents BuyerDocument[]
  referrals Referral[]      @relation("referrer")
  tickets   SupportTicket[]
  shortlist ShortlistItem[]
}

model BuyerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  buyerId    String
  buyer      Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
}

model BuyerOtp {
  id        String    @id @default(cuid())
  buyerId   String
  buyer     Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([buyerId, createdAt])
}

model Purchase {
  id               String    @id @default(cuid())
  reference        String    @unique
  buyerId          String
  buyer            Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id])
  phaseName        String?
  plotNumber       String?
  sizeText         String?
  priceKobo        BigInt
  depositKobo      BigInt
  planMonths       Int
  allocationStatus String    @default("PENDING") // PENDING | ALLOCATED
  allocatedAt      DateTime?
  createdAt        DateTime  @default(now())

  instalments Instalment[]
  documents   BuyerDocument[]
  tickets     SupportTicket[]
  referral    Referral?
}

enum InstalmentStatus {
  DUE
  PART_PAID
  PAID
}

model Instalment {
  id            String           @id @default(cuid())
  purchaseId    String
  purchase      Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sequence      Int
  label         String
  dueDate       DateTime         @db.Date
  amountKobo    BigInt
  paidKobo      BigInt           @default(0)
  status        InstalmentStatus @default(DUE)
  remindersSent String[]         @default([])
  payments      Payment[]

  @@unique([purchaseId, sequence])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

model Payment {
  id            String        @id @default(cuid())
  instalmentId  String
  instalment    Instalment    @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  provider      String // paystack | offline
  providerRef   String        @unique
  amountKobo    BigInt
  status        PaymentStatus @default(PENDING)
  method        String?
  reasonCode    String?
  evidenceRef   String?
  recordedById  String?
  receiptNumber String?       @unique
  rawWebhook    Json?
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
}

model BuyerDocument {
  id           String      @id @default(cuid())
  buyerId      String
  buyer        Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  purchaseId   String?
  purchase     Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  kind         String // CONTRACT | RECEIPT | SURVEY | DEED | ALLOCATION | OTHER
  title        String
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  storageKey   String?
  issuedAt     DateTime    @default(now())
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  PAID
  REJECTED
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referrer       Buyer          @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredLeadId String         @unique
  referredLead   Lead           @relation(fields: [referredLeadId], references: [id], onDelete: Cascade)
  purchaseId     String?        @unique
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(PENDING)
  commissionKobo BigInt         @default(0)
  approvedById   String?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
}

model SupportTicket {
  id         String    @id @default(cuid())
  reference  String    @unique
  buyerId    String
  buyer      Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  subject    String
  body       String
  status     String    @default("OPEN") // OPEN | ANSWERED | CLOSED
  reply      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ShortlistItem {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  propertySlug String
  createdAt    DateTime @default(now())

  @@unique([buyerId, propertySlug])
}
